<?xml version="1.0"?>
<scenario>
	<include file="data/worlds/common/materials.scn"/>
	<include file="data/worlds/common/visual.scn"/>

	<!-- ponytail: standalone freshwater (998 kg/m3) environment instead of
	     <include file="data/worlds/world_empty.scn"/> -- that shared world pulls
	     data/worlds/common/environment.scn which hardcodes saltwater density
	     1031 kg/m3. ALBC's buoyancy target (net +10N) is specced for 998 kg/m3
	     freshwater test-pool conditions, so this scenario declares its own
	     <environment> (ned/atmosphere/wind copied verbatim from environment.scn,
	     only <water density="998.0" .../> changed) rather than risk depending on
	     whether the parser honors a second <environment> block after an include. -->
	<environment>
		<ned latitude="41.7777" longitude="3.0333"/>
		<ocean>
			<water density="998.0" jerlov="0.2" temperature="15.0"/>
			<particles enabled="true"/>
			<waves height="0.0"/>
			<current type="uniform">
				<velocity xyz="0.0 0.0 0.0"/>
			</current>
		</ocean>
		<atmosphere>
			<sun azimuth="20.0" elevation="50.0"/>
			<conditions temperature="20.0" pressure="101300.0" humidity="0.5"/>
			<wind type="uniform">
				<velocity xyz="1.0 0.0 0.0"/>
			</wind>
		</atmosphere>
	</environment>

	<include file="data/robots/albc/albc.scn">
		<arg name="vehicle_name" value="albc"/>
		<arg name="xyz" value="0.0 0.0 80.0"/>
		<arg name="rpy" value="0.0 0.0 0.0"/>
	</include>
</scenario>
