<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sonar_yolo_ros2</name>
  <version>0.5.0</version>
  <description>YOLO object detection on FLS sonar images (JSON detections + annotated image)</description>
  <maintainer email="luckkim123@gmail.com">Seungmin Kim</maintainer>
  <author>Minjong Kim</author>
  <license>GPL-3.0</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>cv_bridge</depend>
  <!-- Runtime also requires the pip-only `ultralytics` package (no rosdep key);
       see README.md -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
